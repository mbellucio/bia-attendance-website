limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${API_RATE_LIMIT};
limit_req_zone $binary_remote_addr zone=steam_login_per_ip:10m rate=${LOGIN_RATE_LIMIT};
limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;

server {
  listen 8080 default_server;
  server_name _;
  server_tokens off;
  client_max_body_size ${CLIENT_MAX_BODY_SIZE};
  limit_req_status 429;
  limit_conn_status 429;
  limit_conn connections_per_ip ${CONNECTIONS_PER_IP};

  location ^~ /api/auth/steam {
    limit_req zone=api_per_ip burst=40 nodelay;
    limit_req zone=steam_login_per_ip burst=10 nodelay;
    include /etc/nginx/snippets/proxy-common.conf;
  }

  location ^~ /api/ {
    limit_req zone=api_per_ip burst=40 nodelay;
    include /etc/nginx/snippets/proxy-common.conf;
  }

  location / {
    include /etc/nginx/snippets/proxy-common.conf;
  }
}

