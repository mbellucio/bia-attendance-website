APP_URL=http://localhost:8080
APP_PORT=8080
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://attendance:replace-with-a-random-hex-password@localhost:5432/attendance
DIRECT_URL=postgresql://attendance:replace-with-a-random-hex-password@localhost:5432/attendance

# Nginx limits in the combined Next.js + Nginx container
API_RATE_LIMIT=10r/s
LOGIN_RATE_LIMIT=2r/s
CONNECTIONS_PER_IP=20
CLIENT_MAX_BODY_SIZE=10m

# Optional Cloudflare Origin CA certificate (mount files at certs/origin.pem and certs/origin.key)
SERVER_NAME=example.com
HTTPS_PORT=443
# Keep HTTP bound to localhost when Cloudflare terminates public traffic.
