APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Discord OAuth link on /profile. Add this redirect in Developer Portal:
# http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_GUILD_ID=replace-with-your-server-id

POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://attendance:replace-with-a-random-hex-password@localhost:5432/attendance
DIRECT_URL=postgresql://attendance:replace-with-a-random-hex-password@localhost:5432/attendance
