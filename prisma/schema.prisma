generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  MOD
  WW2
  CW
  TRN
  SP
  PVP
  OTHER

  @@map("event_type")
}

enum LogLineType {
  OTHER
  PLAYER_CONNECTING
  PLAYER_CONNECTED
  PLAYER_DISCONNECTED

  @@map("log_line_type")
}

enum SoldierFaction {
  US
  GERMANY
  SOVIET_UNION

  @@map("soldier_faction")
}

model User {
  id          String   @id @default(cuid())
  steamId     String   @unique @map("steam_id")
  admin       Boolean  @default(false)
  email       String?
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  profileUrl  String?  @map("profile_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  player          Player?
  modelPreference UserModelPreference?

  @@map("users")
}

model UserModelPreference {
  userId    String         @id @map("user_id")
  faction   SoldierFaction @default(US)
  modelPath String         @map("model_path") @db.Text
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_model_preferences")
}

model Player {
  id            String   @id @default(cuid())
  userId        String?  @unique @map("user_id")
  discordUserId String?  @unique @map("discord_user_id")
  rankId        String?  @map("rank_id")
  timeServedId  String?  @map("time_served_id")
  nickname      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rank                Rank?                 @relation(fields: [rankId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  timeServed          TimeServed?           @relation(fields: [timeServedId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  eventParticipations EventParticipant[]
  logLines            EventLogLine[]
  departments         PlayerDepartment[]
  ribbons             PlayerRibbon[]
  competences         PlayerCompetence[]
  miscellaneous       PlayerMiscellaneous[]
  roles               PlayerRole[]

  @@map("players")
}

model DiscordRole {
  id            String   @id @default(cuid())
  discordRoleId String   @unique @map("discord_role_id")
  name          String
  iconPath      String?  @map("icon_path") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  department    Department?
  rank          Rank?
  ribbon        Ribbon?
  competence    Competence?
  timeServed    TimeServed?
  miscellaneous Miscellaneous?
  players       PlayerRole[]

  @@map("discord_roles")
}

model Department {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  sortOrder     Int      @default(0) @map("sort_order")
  parentId      String?  @map("parent_id")
  discordRoleId String?  @unique @map("discord_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  parent      Department?        @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    Department[]       @relation("DepartmentHierarchy")
  discordRole DiscordRole?       @relation(fields: [discordRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  players     PlayerDepartment[]

  @@index([parentId, sortOrder])
  @@map("departments")
}

model Rank {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  sortOrder     Int      @default(0) @map("sort_order")
  discordRoleId String?  @unique @map("discord_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  discordRole DiscordRole? @relation(fields: [discordRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  players     Player[]

  @@index([sortOrder])
  @@map("ranks")
}

model Ribbon {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  ribbonPath    String?  @map("ribbon_path") @db.Text
  discordRoleId String?  @unique @map("discord_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  discordRole DiscordRole?   @relation(fields: [discordRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  players     PlayerRibbon[]

  @@index([sortOrder])
  @@map("ribbons")
}

model Competence {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  discordRoleId String?  @unique @map("discord_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  discordRole DiscordRole?       @relation(fields: [discordRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  players     PlayerCompetence[]

  @@index([sortOrder])
  @@map("competences")
}

model TimeServed {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  sortOrder     Int      @default(0) @map("sort_order")
  ribbonPath    String?  @map("ribbon_path") @db.Text
  discordRoleId String?  @unique @map("discord_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  discordRole DiscordRole? @relation(fields: [discordRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  players     Player[]

  @@index([sortOrder])
  @@map("time_served")
}

model Miscellaneous {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  discordRoleId String?  @unique @map("discord_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  discordRole DiscordRole?          @relation(fields: [discordRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  players     PlayerMiscellaneous[]

  @@index([sortOrder])
  @@map("miscellaneous")
}

model PlayerDepartment {
  playerId     String @map("player_id")
  departmentId String @map("department_id")

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([playerId, departmentId])
  @@index([departmentId])
  @@map("player_departments")
}

model PlayerRibbon {
  playerId String @map("player_id")
  ribbonId String @map("ribbon_id")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ribbon Ribbon @relation(fields: [ribbonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([playerId, ribbonId])
  @@index([ribbonId])
  @@map("player_ribbons")
}

model PlayerCompetence {
  playerId     String @map("player_id")
  competenceId String @map("competence_id")

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  competence Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([playerId, competenceId])
  @@index([competenceId])
  @@map("player_competences")
}

model PlayerMiscellaneous {
  playerId        String @map("player_id")
  miscellaneousId String @map("miscellaneous_id")

  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  miscellaneous Miscellaneous @relation(fields: [miscellaneousId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([playerId, miscellaneousId])
  @@index([miscellaneousId])
  @@map("player_miscellaneous")
}

model PlayerRole {
  playerId      String @map("player_id")
  discordRoleId String @map("discord_role_id")

  player      Player      @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  discordRole DiscordRole @relation(fields: [discordRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([playerId, discordRoleId])
  @@index([discordRoleId])
  @@map("player_roles")
}

model Event {
  id                       String    @id @default(cuid())
  sourceKey                String    @unique @map("source_key")
  sourceFileName           String?   @map("source_file_name")
  sourceSha256             String?   @map("source_sha256") @db.VarChar(64)
  title                    String
  eventCode                String    @map("event_code")
  eventType                EventType @default(OTHER) @map("event_type")
  game                     String?
  eventDate                DateTime  @map("event_date") @db.Date
  serverTimeZone           String?   @map("server_time_zone")
  missionDurationMinutes   Int?      @map("mission_duration_minutes")
  minimumAttendanceMinutes Int?      @map("minimum_attendance_minutes")
  importedAt               DateTime? @map("imported_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  participants EventParticipant[]
  logLines     EventLogLine[]

  @@index([eventDate])
  @@index([eventCode, eventDate])
  @@map("events")
}

model EventParticipant {
  id                       String    @id @default(cuid())
  eventId                  String    @map("event_id")
  playerId                 String    @map("player_id")
  totalConnectedSeconds    Int?      @map("total_connected_seconds")
  attendanceGranted        Boolean   @default(false) @map("attendance_granted")
  attendanceCalculatedAt   DateTime? @map("attendance_calculated_at")
  attendanceOverride       Boolean?  @map("attendance_override")
  attendanceOverrideReason String?   @map("attendance_override_reason") @db.Text
  calculationVersion       String?   @map("calculation_version")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  player   Player          @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions PlayerSession[]

  @@unique([eventId, playerId])
  @@index([playerId])
  @@map("event_participants")
}

model EventLogLine {
  id                 String      @id @default(cuid())
  eventId            String      @map("event_id")
  lineNumber         Int         @map("line_number")
  rawText            String      @map("raw_text") @db.Text
  timeOfDay          String?     @map("time_of_day") @db.VarChar(8)
  type               LogLineType @default(OTHER)
  reportedPlayerName String?     @map("reported_player_name")
  reportedSteamId    String?     @map("reported_steam_id")
  playerId           String?     @map("player_id")
  parseNote          String?     @map("parse_note") @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")

  event               Event          @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  player              Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  connectedSession    PlayerSession? @relation("SessionConnectLine")
  disconnectedSession PlayerSession? @relation("SessionDisconnectLine")

  @@unique([eventId, lineNumber])
  @@index([playerId])
  @@map("event_log_lines")
}

model PlayerSession {
  id                 String    @id @default(cuid())
  eventParticipantId String    @map("event_participant_id")
  connectLineId      String    @unique @map("connect_line_id")
  disconnectLineId   String?   @unique @map("disconnect_line_id")
  connectedAt        DateTime  @map("connected_at") @db.Timestamp(0)
  disconnectedAt     DateTime? @map("disconnected_at") @db.Timestamp(0)
  durationSeconds    Int?      @map("duration_seconds")
  createdAt          DateTime  @default(now()) @map("created_at")

  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connectLine      EventLogLine     @relation("SessionConnectLine", fields: [connectLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  disconnectLine   EventLogLine?    @relation("SessionDisconnectLine", fields: [disconnectLineId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([eventParticipantId, connectedAt])
  @@map("player_sessions")
}
